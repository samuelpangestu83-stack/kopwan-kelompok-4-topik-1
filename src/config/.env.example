
# --- Cloudflare (dipakai wrangler, bukan oleh Worker) ---
CLOUDFLARE_ACCOUNT_ID=isi_account_id_anda
# CLOUDFLARE_API_TOKEN diatur lewat `wrangler login` atau environment shell, bukan di file.

# --- Nama resource (sesuai docs/runbook.md) ---
WORKER_NAME=topik1-cuaca-serverless
D1_DATABASE_NAME=topik1-cuaca-db
R2_BUCKET_NAME=proyekcloudcomputing

# --- Sumber data (lihat docs/interface-contract.md) ---
WEATHER_LATITUDE=-6.2088
WEATHER_LONGITUDE=106.8456
WEATHER_TIMEZONE=Asia/Jakarta
WEATHER_FORECAST_DAYS=3

# --- Secret (HANYA nama; nilai diset dengan: npx wrangler secret put ADMIN_TOKEN) ---
# ADMIN_TOKEN=
